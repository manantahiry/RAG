            # Import the required dependencies
import pandas as pd

# Sample data creation (for demonstration purposes)
data = {
    "Date de réception": ["07/08/2025", "05/08/2025", "14/08/2025"],
    "Référence de dossier": ["C2531-7818", "C2531-8298", "C2531-7781"],
    "Structure": ["Division des Visas", "Division des Pensions", "Division de la Solde"],
    "Status": ["EN_COURS", "EN_INSTANCE", "REJETE"]
}

# Create DataFrame from sample data
dfs = [pd.DataFrame(data)]

# Initialize an empty DataFrame to store results
result_df = pd.DataFrame(columns=["Structure", "Nouveau", "En Cours", "En Instance", "Rejete", "Total"])

# Count the number of dossiers by structure and status
for df in dfs:
    counts = df.groupby('Structure')['Status'].value_counts().unstack(fill_value=0)
    
    # Prepare the row for the result DataFrame
    new_row = {
        "Structure": counts.index[0],
        "Nouveau": 0,  # Assuming 'Nouveau' is not present in the sample data
        "En Cours": counts.get("EN_COURS", 0),
        "En Instance": counts.get("EN_INSTANCE", 0),
        "Rejete": counts.get("REJETE", 0),
        "Total": counts.sum(axis=1).values[0]
    }
    
    # Append the new row to the result DataFrame
    result_df = result_df.append(new_row, ignore_index=True)

# Calculate the total for all structures
total_row = {
    "Structure": "Total",
    "Nouveau": result_df["Nouveau"].sum(),
    "En Cours": result_df["En Cours"].sum(),
    "En Instance": result_df["En Instance"].sum(),
    "Rejete": result_df["Rejete"].sum(),
    "Total": result_df["Total"].sum()
}

# Append the total row to the result DataFrame
result_df = result_df.append(total_row, ignore_index=True)

# Declare result variable as a dictionary of type and value
result = {
    "type": "dataframe",
    "value": result_df
}

# Display the result DataFrame
print(result_df)
