    df['Date de réception'] = pd.to_datetime(df['Date de réception'], format='%d/%m/%Y', errors='coerce')
    df['Date début de traitement'] = pd.to_datetime(df['Date début de traitement'], format='%d/%m/%Y', errors='coerce')
    df['Date fin de traitement'] = pd.to_datetime(df['Date fin de traitement'], format='%d/%m/%Y', errors='coerce', utc=True)

# Calculate processing duration in days
for df in dfs:
    df['Processing Duration'] = (df['Date fin de traitement'] - df['Date début de traitement']).dt.days

# Find the agent with the minimum processing duration
min_duration_row = dfs[0].loc[dfs[0]['Processing Duration'].idxmin()]
fastest_agent = min_duration_row['Agent responsable']
fastest_duration = min_duration_row['Processing Duration']

# Declare result var: 
result = {
    "type": "string",
    "value": f"The fastest agent is {fastest_agent} with a processing duration of {fastest_duration} days."
}

# Output the result
