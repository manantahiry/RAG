    "Nom et prénoms": ["ANDRIAMAZAVA FRANCOIS JOSEPH", "RAMAMPIANDRARISOA ERNESTINE", "RAZAFIMAMONJY HOBIARISOA ANDRIANJAFINORO"],
    "Région": ["HAUTE MATSIATRA", "HAUTE MATSIATRA", "HAUTE MATSIATRA"],
