    "Date début de traitement": ["11/08/2025", "11/08/2025", "07/08/2025"],
    "Date fin de traitement": ["TRAITE", "12/08/2025", ""],
    "Agent responsable": ["RANDRIAMBAO Aimé", "Monsieur LE RECEVEUR GENERALE D'ANTANANARIVO", "ANDRIAMPENOMAMY Solofoheritiana Noëlson José"]
}

