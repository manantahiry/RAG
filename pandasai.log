import pandas as pd

# Assuming dfs is already defined and contains the DataFrame
# For demonstration, let's create a sample DataFrame similar to the one described
data = {
    "Date de réception": ["11/08/2025", "04/08/2025", "01/08/2025"],
    "Structure": [
        "Division de la Solde",
        "Division des Oppositions,de la vallidation des Services Précaires et de la prévoyance sociale",
        "Division des Visas"
    ],
    "Status": ["REJETE", "EN_COURS", "EN_INSTANCE"]
}

dfs = [pd.DataFrame(data)]

# Concatenate all DataFrames in the list if there are multiple
df = pd.concat(dfs, ignore_index=True)

# Initialize a summary DataFrame
summary = df.groupby('Structure')['Status'].value_counts().unstack(fill_value=0)

# Rename columns to match the required output
summary.columns.name = None  # Remove the name of the columns
summary = summary.rename(columns={
    'EN_COURS': 'en cours',
    'EN_INSTANCE': 'en instance',
    'REJETE': 'rejete',
    'TRAITE': 'traite',  # Assuming TRAITE is another status you might have
    'NOUVEAU': 'nouveau'  # Assuming NOUVEAU is another status you might have
})

# Add a total column
summary['total'] = summary.sum(axis=1)

# Reset index to make 'Structure' a column again
summary.reset_index(inplace=True)

# Calculate the grand total for each category
totals = summary[['en cours', 'en instance', 'rejete', 'traite', 'nouveau']].sum()
totals_df = pd.DataFrame(totals).T
totals_df['Structure'] = 'Total'
summary = pd.concat([summary, totals_df], ignore_index=True)

# Declare result variable
result = {
    "type": "dataframe",
    "value": summary
}

# Display the result
print(result)
