    df['Date début de traitement'] = pd.to_datetime(df['Date début de traitement'], format='%d/%m/%Y', errors='coerce')
    df['Date fin de traitement'] = pd.to_datetime(df['Date fin de traitement'], format='%d/%m/%Y', errors='coerce')

