            # Import the required dependencies
import pandas as pd

# Assuming dfs is already declared and contains the DataFrame
# For demonstration, let's create a sample DataFrame similar to the one described
data = {
    "Date de réception": ["13/08/2025", "14/08/2025", "01/08/2025"],
    "Structure": [
        "Division des Oppositions,de la vallidation des Services Précaires et de la prévoyance sociale",
        "Division des Pensions",
        "Division de la Solde"
    ],
    "Status": ["EN_INSTANCE", "REJETE", "EN_COURS"]
}

dfs = [pd.DataFrame(data)]

# Concatenate all DataFrames in the list into a single DataFrame
df = pd.concat(dfs, ignore_index=True)

# Initialize a summary DataFrame
summary = df.groupby('Structure').agg(
    nouveau=('Status', lambda x: (x == 'NOUVEAU').sum()),
    en_cours=('Status', lambda x: (x == 'EN_COURS').sum()),
    en_instance=('Status', lambda x: (x == 'EN_INSTANCE').sum()),
    rejete=('Status', lambda x: (x == 'REJETE').sum()),
    traite=('Status', lambda x: (x == 'TRAITE').sum())
).reset_index()

# Calculate total for each row and overall total
summary['total'] = summary[['nouveau', 'en_cours', 'en_instance', 'rejete', 'traite']].sum(axis=1)
overall_total = summary['total'].sum()

# Add overall total to the summary DataFrame
summary.loc[len(summary)] = ['Total', summary['nouveau'].sum(), summary['en_cours'].sum(),
                              summary['en_instance'].sum(), summary['rejete'].sum(),
                              summary['traite'].sum(), overall_total]

# Declare result variable
result = {
    "type": "dataframe",
    "value": summary
}

# Display the result
print(result)
